# Copy this file to ".env" and add ONE of the first two keys to turn on the AI caller.
# Without a key the app still runs, using a scripted caller.

# Option 1: Google Gemini (has a free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option 2: Anthropic Claude. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: a more emotional voice for the caller and coach, from ElevenLabs.
# Without it the browser's built-in voices are used.
ELEVENLABS_API_KEY=

# Optional. Which models to use. Gemini takes a comma-separated list, tried in order;
# when one runs out of free quota the next is used.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_COACH_MODEL=gemini-3.5-flash
# SCAM_MODEL=claude-opus-5-5
# ELEVEN_MODEL=eleven_v4_turbo

# Optional. If both AI keys are set, Gemini is used unless you force one here.
# AI_PROVIDER=claude

# Optional. The port the app runs on.
# PORT=3000
